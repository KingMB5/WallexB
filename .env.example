# WallexB — environment (copy to .env and fill what you need)
# NOTHING here is required for paper trading — the bot runs out of the box.

# --- Wallex API ----------------------------------------------------------
# Only needed for live trading or `scripts/check_api.py --private`.
# Get one from wallex.ir panel -> API Keys. NEVER commit this value.
WALLEX_API_KEY=
# WALLEX_BASE_URL=https://api.wallex.ir

# --- Safety switches (BOTH required for real orders) ---------------------
# 1) deliberate configuration …
LIVE_TRADING=0
# 2) … plus an explicit human confirmation string
CONFIRM_LIVE=
# (a real order only happens when LIVE_TRADING=1 AND CONFIRM_LIVE=YES AND a key exists)

# --- Market --------------------------------------------------------------
SYMBOL=BTCTMN
RESOLUTION=60          # candle minutes: 1/5/15/30/60/240/1440
POLL_SECONDS=30
CANDLES=200

# --- Strategy ------------------------------------------------------------
STRATEGY=sma_cross     # sma_cross | rsi_reversion
SMA_FAST=9
SMA_SLOW=21
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# --- Money & risk (Toman) ------------------------------------------------
ORDER_QUOTE_AMOUNT=500000
MAX_POSITION_QUOTE=2000000
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
DAILY_MAX_LOSS_PCT=5
MIN_NOTIONAL=50000
FEE_PCT=0.25           # paper-trading fee model
STARTING_CASH=10000000 # paper wallet in Toman

# --- Housekeeping --------------------------------------------------------
STATE_FILE=state/state.json
LOG_LEVEL=INFO

# --- Optional Telegram notifications -------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=
